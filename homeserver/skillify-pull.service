[Unit]
Description=skillify-core pull + re-audit + map restart (the homeserver ingest gate)
Wants=network-online.target
After=network-online.target
# Skip silently until the deploy-key clone exists (owner setup step); once
# /opt/skillify-core lands, every tick runs for real. No journal failure noise
# before setup is complete.
ConditionPathExists=/opt/skillify-core

[Service]
Type=oneshot
# Runs as the host user: needs docker access + the deploy key under ~/.ssh
User=claud
ExecStart=/opt/skillify-core/homeserver/skillify-pull.sh
# Optional overrides (NTFY_URL, compose path, service name…):
EnvironmentFile=-/etc/default/skillify-pull
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
